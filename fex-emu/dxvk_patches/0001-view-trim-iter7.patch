diff --git a/src/dxvk/dxvk_options.h b/src/dxvk/dxvk_options.h
index 992ec764..3aca62ad 100644
--- a/src/dxvk/dxvk_options.h
+++ b/src/dxvk/dxvk_options.h
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <cstdint>
+
 #include "../util/config/config.h"
 
 namespace dxvk {
@@ -26,6 +28,23 @@ namespace dxvk {
 
     /// HUD elements
     std::string hud;
+
+    /// Maximum age (in presented frames) a cached VkImageView may reach
+    /// before becoming a candidate for eviction via trimIfIdle.
+    /// 0 = disabled (upstream default). On tiler GPUs where each
+    /// VkImageView costs a driver-side mapping (Mali's /dev/mali0),
+    /// setting this to e.g. 120 caps view caches for long-running games.
+    uint32_t imageViewMaxAgeFrames = 0u;
+
+    /// Soft cap on total live VkImageView handles across all wrappers.
+    /// When trimIdleImageViews finds the live count above this, it does
+    /// additional passes with progressively shorter maxAge until either
+    /// the count fits or no more candidates exist (leaving views idle
+    /// for at least 3 frames as a hard floor for GPU-pipeline safety).
+    /// 0 = no pressure trigger (only the time-based trim runs).
+    /// Useful on Mali where ~45k+ live views slows page-table walks
+    /// even after creation rate stabilises.
+    uint32_t imageViewMaxLive = 0u;
   };
 
 }
