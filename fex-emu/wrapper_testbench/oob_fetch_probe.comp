#version 450
/*
 * OOB texelFetch probe for A5 robustImageAccess2 instrumentation.
 * The test harness clears a 1x1 image to a marker before dispatch. The
 * shader then texelFetches one in-bounds and one OOB texel.
 */
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform usampler2D tex;
layout(set = 0, binding = 1) buffer OutBuf { uint outdata[]; };

void main() {
    outdata[0] = texelFetch(tex, ivec2(0, 0), 0).x;
    outdata[1] = texelFetch(tex, ivec2(1024, 0), 0).x;
}
