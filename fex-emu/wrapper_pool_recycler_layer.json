            "vkGetDeviceProcAddr": "WPR_GetDeviceProcAddr"
        },
        "enable_environment": {
            "WRAPPER_POOL_RECYCLER": "1"
        },
        "disable_environment": {
            "WRAPPER_POOL_RECYCLER_DISABLE": "1"
        }
    }
}
